{% set contentData = home.locales[locale] %}
<!-- About Me -->
<section class="wrapper about-section animate-in delay-1" aria-labelledby="about-heading">
  <div class="subtitle-container">
    <div class="subtitle-line" aria-hidden="true"></div>
    <h2 id="about-heading" class="subtitle">{{ contentData.aboutHeading }}</h2>
  </div>
  <dl class="about-profile">
    {% for fact in contentData.aboutFacts %}
      <div class="about-profile-row">
        <dt class="about-profile-label">{{ fact.label }}</dt>
        <dd class="about-profile-value">{{ fact.value }}</dd>
      </div>
    {% endfor %}
  </dl>
  <p class="about-comment">{{ contentData.aboutComment }}</p>
</section>

<!-- Research Interests -->
<section class="wrapper animate-in delay-2" aria-labelledby="interests-heading">
  <div class="subtitle-container">
    <div class="subtitle-line" aria-hidden="true"></div>
    <h2 id="interests-heading" class="subtitle">Research Interests</h2>
  </div>
  <ul class="research-focus-list">
    {% for interest in contentData.interests %}
      <li class="research-focus-item">
        <iconify-icon class="entry-icon" icon="{{ interest.icon }}" aria-hidden="true"></iconify-icon>
        <strong class="research-focus-name">{{ interest.name }}</strong>
      </li>
    {% endfor %}
  </ul>
</section>

<!-- Publications -->
<section class="wrapper animate-in delay-3" aria-labelledby="publications-heading">
  <div class="subtitle-container">
    <div class="subtitle-line" aria-hidden="true"></div>
    <h2 id="publications-heading" class="subtitle">Publications</h2>
  </div>
  <div class="publication-groups">
    {% for group in publications | groupByYearDesc %}
      <section class="publication-year-group" data-publication-year="{{ group.year }}" aria-labelledby="publication-year-{{ group.year }}">
        <div class="publication-year-heading">
          <h3 id="publication-year-{{ group.year }}" class="publication-year">
            <time datetime="{{ group.year }}">{{ group.year }}</time>
          </h3>
          <span class="publication-year-line" aria-hidden="true"></span>
        </div>
        <ul class="publication-list">
          {% for publication in group.publications %}
            <li class="publication-item">
              <article class="publication-entry">
                {% if publication.thumbnail %}
                  <img
                    class="publication-thumbnail"
                    src="{{ publication.thumbnail.src }}"
                    alt="{{ publication.title }}"
                    width="{{ publication.thumbnail.width }}"
                    height="{{ publication.thumbnail.height }}"
                    loading="lazy"
                    decoding="async"
                  />
                {% endif %}
                <div class="publication-body">
                  <h4 class="publication-title">{{ publication.title }}</h4>
                  <p class="publication-authors">
                    {% for author in publication.authors[locale] %}
                      <span class="publication-author{% if author.self %} publication-author--self{% endif %}">{{ author.name }}</span>
                      <span class="publication-affiliation">({{ author.affiliation }})</span>{% if not loop.last %}<span class="publication-author-separator">, </span>{% endif %}
                    {% endfor %}
                  </p>
                  <p class="publication-venue"><span class="publication-venue-prefix" aria-hidden="true">-</span> {{ publication.venue[locale] }}</p>
                  {% if publication.links.length %}
                    <div class="publication-links">
                      {% for link in publication.links %}
                        <a class="publication-link" href="{{ link.url }}"{% if link.external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ link.label }}</a>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
              </article>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endfor %}
  </div>
</section>

<!-- Grants -->
<section class="wrapper animate-in delay-4" aria-labelledby="grants-heading">
  <div class="subtitle-container">
    <div class="subtitle-line" aria-hidden="true"></div>
    <h2 id="grants-heading" class="subtitle">Grants</h2>
  </div>
  <ul class="grant-list">
    {% for grant in grants | sortByYearDesc %}
      <li class="grant-item">
        <article class="grant-entry">
          <h3 class="grant-title">{{ grant.name[locale] }}</h3>
          <p class="grant-role">{{ grant.role[locale] }}</p>
          <p class="grant-period"><time datetime="{{ grant.year }}">{{ grant.period[locale] }}</time></p>
        </article>
      </li>
    {% endfor %}
  </ul>
</section>

<!-- Skills -->
<section class="wrapper skills-section animate-in delay-5" aria-labelledby="skills-heading">
  <div class="subtitle-container">
    <div class="subtitle-line" aria-hidden="true"></div>
    <h2 id="skills-heading" class="subtitle">Skills</h2>
  </div>
  <div class="skill-chips">
    {% for skill in site.skills %}
      <div class="skill-chip scroll-reveal">
        <iconify-icon icon="{{ skill.icon }}"{% if skill.accent %} style="color:var(--accent)"{% endif %} aria-hidden="true"></iconify-icon>
        <span>{{ skill.name }}</span>
      </div>
    {% endfor %}
  </div>
</section>
