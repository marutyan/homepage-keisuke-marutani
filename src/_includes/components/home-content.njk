{% set contentData = home.locales[locale] %}
<!-- About Me -->
<section class="wrapper about-section animate-in delay-1" aria-labelledby="about-heading">
  <div class="subtitle-container">
    <div class="subtitle-line" aria-hidden="true"></div>
    <h2 id="about-heading" class="subtitle">{{ contentData.aboutHeading }}</h2>
  </div>
  <div class="about-copy">
    {% for paragraph in contentData.aboutParagraphs %}
      <p>{{ paragraph }}</p>
    {% endfor %}
  </div>
  <p class="about-comment">{{ contentData.aboutComment }}</p>
</section>

<!-- Research Interests -->
<section class="wrapper animate-in delay-2" aria-labelledby="interests-heading">
  <div class="subtitle-container">
    <div class="subtitle-line" aria-hidden="true"></div>
    <h2 id="interests-heading" class="subtitle">Research Interests</h2>
  </div>
  <ul class="interests content-list">
    {% for interest in contentData.interests %}
      <li class="other-list-item"><strong>{{ interest }}</strong></li>
    {% endfor %}
  </ul>
</section>

<!-- Publications -->
<section class="wrapper animate-in delay-3" aria-labelledby="publications-heading">
  <div class="subtitle-container">
    <div class="subtitle-line" aria-hidden="true"></div>
    <h2 id="publications-heading" class="subtitle">Publications</h2>
  </div>
  <ul class="publication-list">
    {% for publication in publications | sortByYearDesc %}
      <li class="publication-item" data-publication-year="{{ publication.year }}">
        <span class="publication-marker" aria-hidden="true"></span>
        <article class="publication-entry">
          <h3 class="publication-title">{{ publication.title }}</h3>
          <p class="publication-authors">{{ publication.authors[locale] }}</p>
          <p class="publication-venue">{{ publication.venue[locale] }}</p>
          {% if publication.links.length %}
            <div class="publication-links">
              {% for link in publication.links %}
                <a class="publication-link" href="{{ link.url }}"{% if link.external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ link.label }}</a>
              {% endfor %}
            </div>
          {% endif %}
        </article>
      </li>
    {% endfor %}
  </ul>
</section>

<!-- Skills -->
<section class="wrapper skills-section animate-in delay-4" aria-labelledby="skills-heading">
  <div class="subtitle-container">
    <div class="subtitle-line" aria-hidden="true"></div>
    <h2 id="skills-heading" class="subtitle">Skills</h2>
  </div>
  <div class="skill-chips">
    {% for skill in site.skills %}
      <div class="skill-chip scroll-reveal">
        <iconify-icon icon="{{ skill.icon }}"{% if skill.accent %} style="color:var(--accent)"{% endif %} aria-hidden="true"></iconify-icon>
        <span>{{ skill.name }}</span>
      </div>
    {% endfor %}
  </div>
</section>
